{
	"name": "canvas-bases",
	"version": "0.1.3",
	"description": "Canvas-style layouts and JSON Canvas materialization for Bases.",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"build:testbed-adapter": "esbuild scripts/testbed-adapter.ts --bundle --platform=node --format=cjs --target=node20 --alias:obsidian=obsidian-test-mocks/obsidian --outfile=.testbed/testbed-adapter.cjs",
		"build:test": "npm run build && node copy-files.mjs",
		"copy-files": "node copy-files.mjs",
		"dev": "node esbuild.config.mjs",
		"i18n:sync": "i18n-state sync",
		"i18n:verify": "i18n-state verify",
		"i18n:status": "i18n-state status",
		"i18n:check-usage": "i18n-state check-usage",
		"i18n:find-unused": "i18n-state find-unused",
		"i18n:check-duplicates": "i18n-state check-duplicates",
		"i18n:generate-template": "i18n-state generate-template",
		"lint": "npm run lint:ts && npm run lint:css",
		"lint:ts": "eslint . --max-warnings=0",
		"lint:css": "stylelint styles.css --max-warnings=0",
		"smoke:canvas": "vitest run tests/canvasBuilder.test.ts",
		"test": "vitest run",
		"test:testbed": "npm run build:testbed-adapter && node ../mdbase-spec/packages/testbed/src/cli.mjs run --adapter scripts/testbed-adapter-bootstrap.cjs --scenario interop.application-provider-lifecycle --scenario interop.application-event-multicast",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"obsidian",
		"bases",
		"canvas",
		"json-canvas"
	],
	"author": "Callum Alpass",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^24.3.0",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^16.5.0",
		"i18n-state-manager": "^0.1.0",
		"jsdom": "^29.1.1",
		"obsidian": "^1.12.3",
		"obsidian-test-mocks": "^3.1.0",
		"obsidian-typings": "^6.24.0",
		"postcss-selector-parser": "^7.1.1",
		"stylelint": "^17.12.0",
		"typescript": "^5.9.2",
		"vitest": "^4.0.13"
	},
	"dependencies": {
		"@callumalpass/mdbase-interop": "0.1.0-rc.2",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6"
	}
}

{
	"name": "baseboard",
	"version": "0.1.0",
	"description": "Materialize Obsidian Bases views as Canvas boards.",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"build:test": "npm run build && node copy-files.mjs",
		"copy-files": "node copy-files.mjs",
		"dev": "node esbuild.config.mjs",
		"lint": "npm run lint:ts && npm run lint:css",
		"lint:ts": "eslint . --max-warnings=0",
		"lint:css": "stylelint styles.css --max-warnings=0",
		"smoke:canvas": "vitest run tests/canvasBuilder.test.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"obsidian",
		"bases",
		"canvas",
		"json-canvas"
	],
	"author": "Callum Alpass",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^24.3.0",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"esbuild": "^0.25.9",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^16.5.0",
		"obsidian": "^1.12.3",
		"obsidian-typings": "^4.49.0",
		"postcss-selector-parser": "^7.1.1",
		"stylelint": "^17.12.0",
		"typescript": "^5.9.2",
		"vitest": "^4.0.13"
	}
}
